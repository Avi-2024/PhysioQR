# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/physioqr

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_EXPIRES_IN=15m
ACCESS_TOKEN_COOKIE_NAME=physioqr_access
REFRESH_TOKEN_COOKIE_NAME=physioqr_refresh
ADMIN_SETUP_SECRET=change_this_after_first_admin

# OTP
# Use twilio in production. Keep db only for development/testing.
OTP_PROVIDER=db
OTP_EXPIRY_MINUTES=10
OTP_DAILY_LIMIT=5
OTP_MAX_ATTEMPTS=5
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid
TWILIO_VERIFY_CHANNEL=sms
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Notification delivery
# Use provider in production. Use log for development/testing.
NOTIFICATION_DELIVERY_MODE=log
NOTIFICATION_MAX_RETRIES=5
NOTIFICATION_RETRY_BASE_SECONDS=60
NOTIFICATION_WORKER_BATCH_SIZE=50

# Browser Web Push (VAPID)
WEB_PUSH_VAPID_PUBLIC_KEY=your_vapid_public_key
WEB_PUSH_VAPID_PRIVATE_KEY=your_vapid_private_key
WEB_PUSH_VAPID_SUBJECT=mailto:support@physioqr.in

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password
EMAIL_FROM=PhysioQR <no-reply@physioqr.in>

# Payment Gateway
PAYMENT_GATEWAY_MODE=razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Doctor document storage
# Use s3 in production. Use local for smoke tests/dev metadata-only mode.
DOCUMENT_STORAGE_MODE=s3
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-private-kyc-bucket
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Fraud rules
FRAUD_QR_SCAN_THRESHOLD=20
FRAUD_REFUND_THRESHOLD=5

# App URL
APP_URL=https://physioqr.in
FRONTEND_URL=http://localhost:3000
