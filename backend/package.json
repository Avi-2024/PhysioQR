{
  "name": "physioqr-backend",
  "version": "1.0.0",
  "description": "PhysioQR Doctor Referral and Rehabilitation Platform - Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "seed:demo": "node scripts/seedDemoData.js",
    "seed:test-users": "node scripts/seedTestUsers.js",
    "seed:assessment-pathways": "node scripts/seedAssessmentPathways.js",
    "seed:assessment-questions": "node scripts/seedAssessmentQuestions.js",
    "seed:assessment-content": "npm run seed:assessment-pathways && npm run seed:assessment-questions",
    "seed:rehab-programs": "node scripts/seedRehabPrograms.js",
    "seed:knee-general-30d-draft": "node scripts/seedGeneralKnee30DayDraft.js",
    "validate:knee-general-30d-draft": "node scripts/seedGeneralKnee30DayDraft.js --validate",
    "test:knee-general-30d-draft": "node --test tests/generalKnee30DayDraft.test.js tests/programmeReleaseChecklist.test.js",
    "test:patient-programme-publication": "node --test tests/patientProgrammePublication.test.js",
    "test:exercise-bulk-status": "node --test tests/exerciseBulkStatus.test.js",
    "demo:exercise-videos": "node scripts/addDemoYoutubeToExercises.js",
    "demo:exercise-videos:apply": "node scripts/addDemoYoutubeToExercises.js --apply",
    "demo:exercise-videos:remove": "node scripts/addDemoYoutubeToExercises.js --remove",
    "knee:video-candidates": "node scripts/assignGeneralKneeExerciseVideos.js",
    "knee:video-candidates:apply": "node scripts/assignGeneralKneeExerciseVideos.js --apply",
    "test:knee-video-candidates": "node --test tests/kneeVideoCandidates.test.js tests/kneeProgrammeSingleSignoff.test.js tests/kneeProgrammeApprovalProjection.test.js",
    "test:demo-exercise-videos": "node --test tests/demoExerciseVideos.test.js tests/demoExerciseAdminAction.test.js",
    "seed:clinical-content": "npm run seed:assessment-pathways && npm run seed:assessment-questions && npm run seed:rehab-programs",
    "reset:all-except-admin": "node scripts/resetAllExceptAdmin.js",
    "test:integration": "node scripts/integrationSmoke.js",
    "test:assessment-visibility": "node --test tests/assessmentVisibility.test.js",
    "test:patient-auto-clearance": "node --test tests/patientAssessmentClearance.test.js",
    "test:assessment-questions": "node --test tests/patientAssessmentQuestions.test.js",
    "retire:description-questions": "node scripts/retireOpenEndedAssessmentQuestions.js",
    "worker:notifications": "node scripts/notificationWorker.js",
    "migrate:rehab-content": "node scripts/migrateProgramContent.js",
    "audit:rehab-content": "node scripts/auditRehabContent.js",
    "inspect:rehab-db": "node scripts/inspectRehabDb.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1109.0",
    "@aws-sdk/s3-request-presigner": "^3.1109.0",
    "@sentry/node": "^10.70.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.5",
    "qrcode": "^1.5.3",
    "razorpay": "^2.9.2",
    "twilio": "^4.19.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
