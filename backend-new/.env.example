NODE_ENV=development

# ─── Service Ports ────────────────────────────────────────────────────────────
API_GATEWAY_PORT=4000
AUTH_IAM_PORT=4100
LEAD_MANAGEMENT_PORT=4200
INTEGRATION_PORT=4300

# ─── Unified Database URL ──────────────────────────────────────────────────────
# All three microservices connect to the same PostgreSQL database.
# Service isolation is maintained through PostgreSQL schemas:
#   - auth_iam       → Auth/IAM Service
#   - lead_management → Lead Management Service
#   - integration   → Integration Service
SOLOCRM_DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:5432/solo_crm"
DATABASE_POOL_CONNECTION_LIMIT=10

# ─── Old Database URLs (uncomment temporarily for data migration or rollback) ──
# AUTH_IAM_DATABASE_URL="postgresql://postgres:password@localhost:5433/auth_iam"
# LEAD_MANAGEMENT_DATABASE_URL="postgresql://postgres:password@localhost:5434/lead_management"
# INTEGRATION_DATABASE_URL="postgresql://postgres:password@localhost:5435/integration"

# ─── JWT Secrets (generate with: openssl rand -base64 64) ────────────────────
JWT_ACCESS_SECRET="replace-with-strong-access-secret"
JWT_REFRESH_SECRET="replace-with-strong-refresh-secret"
JWT_ACCESS_EXPIRES_IN="8h"
JWT_REFRESH_EXPIRES_DAYS=1
REFRESH_COOKIE_NAME="upstep_refresh_token"
COOKIE_SECURE=true

# ─── Internal Service URLs ────────────────────────────────────────────────────
AUTH_IAM_BASE_URL="http://localhost:4100"
LEAD_MANAGEMENT_BASE_URL="http://localhost:4200"
INTEGRATION_BASE_URL="http://localhost:4300"
INTERNAL_SERVICE_SECRET="replace-with-strong-internal-service-secret"

# ─── CORS / Frontend ──────────────────────────────────────────────────────────
FRONTEND_BASE_URL="http://localhost:5173"

# ─── Company Branding (served via GET /public/branding) ──────────────────────
# These are read by the API Gateway and returned to the frontend on app load.
# Override them to match your company's identity.
PUBLIC_BRANDING_APP_NAME="UPSTEP CRM"
PUBLIC_BRANDING_LOGO_URL="/brand/default-logo.png"
PUBLIC_BRANDING_FAVICON_URL="/brand/default-favicon.svg"
PUBLIC_BRANDING_PRIMARY_COLOR="#1F7A8C"
PUBLIC_BRANDING_SECONDARY_COLOR="#F2B705"
PUBLIC_BRANDING_SIDEBAR_COLOR="#14213D"
PUBLIC_BRANDING_BACKGROUND_COLOR="#F6F8FB"
PUBLIC_BRANDING_TEXT_COLOR="#1C2535"
PUBLIC_BRANDING_SUPPORT_EMAIL="support@yourcompany.com"
PUBLIC_BRANDING_SUPPORT_PHONE="+1 555 0100"

# ─── Bootstrap Admin User ─────────────────────────────────────────────────────
# Created automatically on first boot (development only). Change before production.
BOOTSTRAP_EMAIL="admin@yourcompany.com"
BOOTSTRAP_PASSWORD="change-this-strong-password"
BOOTSTRAP_USER_NAME="Company Admin"

# ─── Quotation PDF (AWS S3) ───────────────────────────────────────────────────
LEAD_OUTBOX_WORKER_BATCH_SIZE=50
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="replace-with-least-privilege-access-key"
AWS_SECRET_ACCESS_KEY="replace-with-least-privilege-secret-key"
QUOTATION_S3_BUCKET="replace-with-private-quotation-bucket"
QUOTATION_S3_KMS_KEY_ID=""
QUOTATION_DOWNLOAD_URL_EXPIRES_SECONDS=300
QUOTATION_DOCUMENT_WORKER_BATCH_SIZE=5
QUOTATION_DOCUMENT_MAX_ATTEMPTS=5
QUOTATION_DOCUMENT_LOCK_TIMEOUT_MS=600000

# ─── Meta / Facebook Lead Integration ────────────────────────────────────────
META_APP_ID="replace-with-meta-app-id"
META_APP_SECRET="replace-with-meta-app-secret"
META_LOGIN_CONFIG_ID="replace-with-facebook-login-for-business-config-id"
META_WEBHOOK_VERIFY_TOKEN="replace-with-meta-webhook-verify-token"
META_WEBHOOK_APP_SECRET="replace-with-meta-webhook-app-secret"
META_GRAPH_VERSION="v25.0"
META_OAUTH_SCOPES="pages_show_list,pages_manage_metadata,pages_read_engagement,leads_retrieval,ads_read,business_management"
INTEGRATION_ENCRYPTION_KEY="replace-with-32-byte-base64-key"
META_WORKER_BATCH_SIZE=25
META_WORKER_CONCURRENCY=5
META_WORKER_HEARTBEAT_INTERVAL_MS=30000
META_WORKER_HEARTBEAT_STALE_MS=90000
META_CONNECTION_RECONCILE_INTERVAL_MS=600000
META_GRAPH_REQUEST_TIMEOUT_MS=15000

# ─── Auth Outbox Worker ───────────────────────────────────────────────────────
AUTH_OUTBOX_WORKER_BATCH_SIZE=50

# ─── Realtime (Redis — set REALTIME_ENABLED=true to activate) ────────────────
REALTIME_ENABLED=false
REALTIME_SOCKET_PATH="/realtime/socket.io"
WORKER_WAKE_ENABLED=false
WORKER_RECOVERY_INTERVAL_MS=60000
# For Redis TCP: redis:// or rediss://
REDIS_URL="redis://localhost:6379"
# For Upstash REST, set REDIS_URL to https://... or set these explicitly:
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
