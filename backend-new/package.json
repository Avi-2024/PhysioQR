{
  "name": "backend-new-saas-lead-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Microservice monorepo for a reusable multi-tenant SaaS lead management backend.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm run start:render",
    "dev:services": "concurrently --kill-others-on-fail --names auth,lead,integration,gateway \"npm run dev:auth\" \"npm run dev:lead\" \"npm run dev:integration\" \"npm run dev:gateway\"",
    "dev:gateway": "node apps/api-gateway/src/server.js",
    "dev:auth": "node apps/auth-iam-service/src/server.js",
    "dev:lead": "node apps/lead-management-service/src/server.js",
    "dev:integration": "node apps/integration-service/src/server.js",
    "worker:auth:outbox": "node apps/auth-iam-service/src/workers.outbox.js",
    "worker:lead:outbox": "node apps/lead-management-service/src/workers.outbox.js",
    "worker:lead:quotation-documents": "node apps/lead-management-service/src/workers.quotation-documents.js",
    "worker:integration:meta": "node apps/integration-service/src/workers.meta.js",
    "lint": "eslint .",
    "build": "node scripts/prisma-each.mjs validate generate",
    "start": "npm run start:render",
    "start:all": "npm run start:render",
    "start:services": "concurrently --kill-others-on-fail --names auth,lead,integration,gateway \"node apps/auth-iam-service/src/server.js\" \"node apps/lead-management-service/src/server.js\" \"node apps/integration-service/src/server.js\" \"node apps/api-gateway/src/server.js\"",
    "start:render": "concurrently --kill-others-on-fail --names auth,lead,integration,gateway,meta-worker,lead-outbox,quotation-docs,auth-outbox \"node apps/auth-iam-service/src/server.js\" \"node apps/lead-management-service/src/server.js\" \"node apps/integration-service/src/server.js\" \"node apps/api-gateway/src/server.js\" \"node apps/integration-service/src/workers.meta.js\" \"node apps/lead-management-service/src/workers.outbox.js\" \"node apps/lead-management-service/src/workers.quotation-documents.js\" \"node apps/auth-iam-service/src/workers.outbox.js\"",
    "prisma:validate": "node scripts/prisma-each.mjs validate",
    "prisma:generate": "node scripts/prisma-each.mjs generate",
    "prisma:push": "node scripts/prisma-each.mjs push",
    "db:init": "node scripts/init-db.mjs",
    "db:migrate:validate": "node scripts/migrate-to-unified-db.mjs --validate",
    "db:migrate:copy": "node scripts/migrate-to-unified-db.mjs --copy",
    "prisma:lead:migrate:deploy": "prisma migrate deploy --schema apps/lead-management-service/prisma/schema.prisma",
    "prisma:integration:migrate:deploy": "prisma migrate deploy --schema apps/integration-service/prisma/schema.prisma",
    "seed:demo-leads": "node scripts/seed-demo-leads.mjs",
    "auth:create-account": "node scripts/create-auth-account.mjs",
    "auth:backfill-meeting-permissions": "node scripts/backfill-meeting-permissions.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "@prisma/client": "^6.12.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^2.4.3",
    "concurrently": "^10.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "html-to-pdfmake": "^2.5.33",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.2",
    "pdfmake": "^0.2.20",
    "pino": "^9.8.0",
    "pino-http": "^10.5.0",
    "puppeteer": "^25.3.0",
    "redis": "^6.1.0",
    "sanitize-html": "^2.17.6",
    "socket.io": "^4.8.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "eslint": "^9.31.0",
    "prisma": "^6.12.0",
    "supertest": "^7.1.1"
  }
}
